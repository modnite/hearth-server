# Everything here is optional except SESSION_SECRET. `sh scripts/setup.sh` writes a working .env for you.
# Most of these can also be changed later in the admin panel (/admin, Settings); a value set there wins over this file.

# --- The server ---
# The name people reach this server by. Used by the "tls" profile (Caddy gets the certificate for it).
HEARTH_DOMAIN=localhost
# Signs session cookies. Long and random:  openssl rand -hex 32
SESSION_SECRET=
# Where the port is published, and which. Use HEARTH_BIND=127.0.0.1 behind your own reverse proxy.
HEARTH_BIND=0.0.0.0
HEARTH_PORT=8080
# Pull a published image instead of building:  HEARTH_IMAGE=ghcr.io/modnite/hearth-server:latest
HEARTH_IMAGE=hearth-server:latest

# --- First account ---
# Easiest: leave both empty, start the server and open /admin to create the first administrator.
FIRST_USER_USERNAME=
FIRST_USER_PASSWORD=

# --- Joining ---
# invite: needs an invite code or the house key.  open: anyone who can reach the server.
REGISTRATION=invite
# A shared passphrase (8+ characters) that works like an invite code for everyone who knows it. Empty = off.
REGISTRATION_KEY=

# --- Look and feel ---
HEARTH_NAME=
# Backup space per person in MB (default 4096)
BACKUP_QUOTA_MB=

# --- Voice and video (LiveKit). On when COMPOSE_PROFILES=calls (scripts/setup.sh writes it on Linux) ---
# COMPOSE_PROFILES=calls
LIVEKIT_API_KEY=hearth
# Long and random:  openssl rand -hex 32
LIVEKIT_API_SECRET=
# What clients connect to. wss://your-domain with the tls profile, ws://your-ip:7880 on a home network.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://host.docker.internal:7880
LIVEKIT_TAG=v1.13.11
# Media ports to forward on your router
LIVEKIT_UDP_RANGE_START=50100
LIVEKIT_UDP_RANGE_END=50199
LIVEKIT_TCP_PORT=7881
# On a VPS the address is fixed: set it and the lookup is skipped. Blank on a home connection = detect it.
PUBLIC_IP=
PUBLIC_IP_URL=https://api.ipify.org

# --- Browser and PWA notifications (optional). Generate a pair once:  npm --prefix server run vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
