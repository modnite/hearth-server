{
  "name": "hearth-server",
  "version": "1.0.1",
  "description": "The Hearth server: accounts, chats, calls, backups and an admin panel. Clients such as Ember or the Hearth web app talk to it over HTTP and WebSocket.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-admin.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vapid": "tsx scripts/vapid.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@livekit/rtc-node": "^1.1.0",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0",
    "livekit-server-sdk": "^2.9.0",
    "nanoid": "^5.0.9",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.4"
  }
}
